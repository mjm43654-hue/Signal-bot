name: 4H Live Market Scanner

on:
  schedule:
    # هر نیم ساعت یک سرور تازه نفس روشن می‌شود
    - cron: '*/30 * * * *'
  workflow_dispatch:

jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Run Gann & Ichimoku Live Loop
        run: |
          python -c "
          import trading_signal_bot as bot
          import time

          print('🚀 شروع مانیتورینگ زنده بازار (هر ۶۰ ثانیه)...')
          # این سرور به مدت ۵۰ دقیقه بدون توقف روشن می‌ماند
          start_time = time.time()
          while time.time() - start_time < 3000:
              try:
                  bot.run_scan()
              except Exception as e:
                  print('Error:', e)
              time.sleep(60)
          "
